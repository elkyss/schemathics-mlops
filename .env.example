# Copy to .env and fill in what you need. .env is gitignored — never commit real keys.

# Prior Labs API key (https://ux.priorlabs.ai/account). Hosted TabPFN; also needed once to download local weights.
TABPFN_TOKEN=
# Payout model: local (default: OSS TabPFN on CPU, ~0.2 s, no per-call cost) | api (hosted, more accurate, ~1.7 s,
# ~10k credits per call) | fallback (mean payout per brand). Without TABPFN_TOKEN, local/api fall back automatically.
TABPFN_BACKEND=local
# Serve a model through another backend without retraining (e.g. during an API outage): api | local | fallback
# SERVE_PAYOUT_BACKEND=
# Seconds TabPFN may take before the fallback payout answers
# TABPFN_DEADLINE_S=2.0

# Training / lifecycle
# HOLDOUT_DAYS_PROD=0          # 7 = original behaviour (production also holds out the last week)
# AUTO_PROMOTE=true            # false = new versions wait at @challenger for `make promote`
# GATE_MAX_REGRESSION=0.05
# SCHEDULE_CRON=0 5 * * 0
# SCHEDULER_TZ=Asia/Jerusalem

# Serving
# ADMIN_TOKEN=                 # protects POST /admin/reload when set
# CACHE_TTL_S=600
# CACHE_MAX_ITEMS=10000        # 0 disables the response cache
